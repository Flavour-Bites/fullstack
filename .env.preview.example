# =============================================================================
# Flavour Bites — Preview Environment (NODE_ENV=preview)
# =============================================================================
# Copy this file to .env.preview and fill in the values.
#
# Preview runs the production-shaped code path (strict CSP/CORS, no Vite HMR,
# built SPA served by the API process) against a NON-production database, so
# the real Telegram OIDC flow can be exercised end to end behind a public
# https tunnel (e.g. cloudflared). Same NODE_ENV is 'preview', NOT 'production'.
#
# Quick tunnel + run:
#   cloudflared tunnel --url http://localhost:3000   # note the https://*.trycloudflare.com URL
#   cp .env.preview.example .env.preview             # paste the tunnel URL below
#   npm run build:preview
#   npm run start:preview
#
# Then register https://<tunnel>/api/auth/telegram/callback as an OIDC
# redirect URI in BotFather and visit https://<tunnel> in your browser.

# ── Required ──────────────────────────────────────────────────────────────────

# Use a LOCAL/preview database, never the production Neon URL.
DATABASE_URL=postgresql://flavour:flavour@localhost:5432/flavour_bites?sslmode=disable

# NODE_ENV=preview is set by the npm scripts; declared here for clarity.
NODE_ENV=preview

# Public tunnel URL — ALL of these must be the SAME single origin:
APP_URL=https://YOUR_TUNNEL.trycloudflare.com
FRONTEND_URL=https://YOUR_TUNNEL.trycloudflare.com
VITE_API_URL=https://YOUR_TUNNEL.trycloudflare.com

# JWT secret — minimum 64 random characters. Reuse the dev .env value or generate a new one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Optional but recommended: keep the CSRF secret independent of the JWT secret.
CSRF_SECRET=

# Telegram bot + OIDC credentials (from @BotFather). Use the SAME bot as
# production — Telegram verifies the OIDC client id/secret on the token endpoint.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPENID_CONNECT_CLIENT_ID=
TELEGRAM_OPENID_CONNECT_CLIENT_SECRET=

# Optional (matches the values already in .env)
TELEGRAM_STAFF_CHAT_ID=
CLOUDINARY_URL=
GEMINI_API_KEY=
PORT=3000

# Redis URL for OIDC state + conversation state (falls back to in-memory store)
# REDIS_URL=redis://localhost:6379