# Frontend image for the local docker-compose stack.
#
# Mirrors the Vercel deployment: builds the client bundle with `vite build`
# (`npm run build:client`, output dist/client) and serves it as static files.
# It never runs the Express server or the server build.
#
# VITE_API_URL is baked into the bundle at build time, exactly as on Vercel.
FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

COPY . .

ARG VITE_API_URL=http://localhost:3000
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build:client

FROM nginx:1.27-alpine AS runner

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/client /usr/share/nginx/html

EXPOSE 80
