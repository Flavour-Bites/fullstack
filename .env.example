# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection URL:
# - Local Docker dev (after `npm run dev:db`): postgresql://flavour:flavour@localhost:5432/flavour_bites
# - Neon / Cloud: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://mock_user:mock_password@localhost:5432/mock_flavour_bites?sslmode=disable

# JWT secret — minimum 64 random characters
JWT_SECRET=c157833a6b289cf887cfdb15b497c473138b3fc8f24419ad24f603c13ff24726

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAFlavourBitesMockBotToken1234567890

# Public URL of the app
APP_URL=http://localhost:3000

# Secret token set via Telegram's setWebhook secret_token parameter.
TELEGRAM_WEBHOOK_SECRET=mock_webhook_secret_token_1234567890abcdef

# Telegram OpenID Connect Credentials (from @BotFather)
TELEGRAM_OPENID_CONNECT_CLIENT_ID=123456789
TELEGRAM_OPENID_CONNECT_CLIENT_SECRET=mock_telegram_openid_secret_1234567890

# Cloudinary URL for media uploads
CLOUDINARY_URL=cloudinary://mock_key:mock_secret@mock_cloud

# ── Optional ──────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:3000

FRONTEND_URL=http://localhost:5173

GEMINI_API_KEY=mock_gemini_api_key_1234567890

# Telegram staff group chat ID (negative number)
TELEGRAM_STAFF_CHAT_ID=-1001234567890

CLOUDINARY_UPLOAD_FOLDER=flavour-bites

PORT=3000

# Redis URL for conversation state (optional; falls back to in-memory store if omitted)
# - Local Docker dev (after `npm run dev:db`): redis://localhost:6379
# REDIS_URL=redis://localhost:6379