{
  "name": "flavour-bites",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "DATABASE_URL=postgresql://flavour:flavour@localhost:${DEV_POSTGRES_PORT:-5432}/flavour_bites REDIS_URL=redis://localhost:${DEV_REDIS_PORT:-6379} nodemon",
    "dev:web": "vite",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "db:push": "DATABASE_URL=postgresql://flavour:flavour@localhost:${DEV_POSTGRES_PORT:-5432}/flavour_bites prisma db push",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/core/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview:build:client": "vite build --mode preview",
    "preview:build": "npm run preview:build:client && npm run build:server",
    "preview:start": "DOTENV_CONFIG_PATH=.env.preview NODE_ENV=preview node dist/server.cjs",
    "preview:dev": "DOTENV_CONFIG_PATH=.env.preview NODE_ENV=preview tsx src/server/core/server.ts",
    "start": "node dist/server.cjs",
    "postinstall": "npx prisma generate; true",
    "db:seed": "DATABASE_URL=postgresql://flavour:flavour@localhost:${DEV_POSTGRES_PORT:-5432}/flavour_bites tsx prisma/seed/index.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:client": "vitest run src/client test/client",
    "test:server": "vitest run src/server test/server"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "grammy": "^1.44.0",
    "helmet": "^8.2.0",
    "jose": "^6.2.4",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "nodemonConfig": {
    "exec": "tsx src/server/core/server.ts",
    "watch": [
      "src/server",
      "prisma"
    ],
    "ext": "ts,json"
  }
}
