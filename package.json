{
  "name": "flavour-bites",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "tsx src/app/server.ts",
    "build": "vite build && esbuild src/app/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "postinstall": "npx prisma generate; true",
    "db:seed": "tsx prisma/seed/index.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "vitest run src/features/auth/tests",
    "test:orders": "vitest run src/features/orders/tests",
    "test:reviews": "vitest run src/features/reviews/tests",
    "test:stats": "vitest run src/features/stats/tests",
    "test:users": "vitest run src/features/users/tests",
    "test:contact": "vitest run src/features/contact/tests",
    "test:components": "vitest run src/test/components",
    "test:admin": "vitest run src/test/components/admin",
    "test:telegram": "vitest run src/test/integrations/telegram",
    "test:redis": "vitest run src/test/integrations/redis",
    "test:utils": "vitest run src/test/shared/utils",
    "test:app": "vitest run src/test/app"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "grammy": "^1.46.0",
    "helmet": "^8.2.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "morgan": "^1.12.1",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
