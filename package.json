{
  "name": "flavour-bites",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "tsx src/app/server.ts",
    "build": "vite build && esbuild src/app/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "postinstall": "npx prisma generate; true",
    "db:seed": "tsx prisma/seed/index.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "vitest run src/tests/modules/auth",
    "test:orders": "vitest run src/tests/modules/orders",
    "test:reviews": "vitest run src/tests/modules/reviews",
    "test:stats": "vitest run src/tests/modules/stats",
    "test:users": "vitest run src/tests/modules/users",
    "test:contact": "vitest run src/tests/modules/contact",
    "test:components": "vitest run src/tests/components",
    "test:admin": "vitest run src/tests/components/admin",
    "test:telegram": "vitest run src/tests/integrations/telegram",
    "test:redis": "vitest run src/tests/integrations/redis",
    "test:utils": "vitest run src/tests/shared/utils",
    "test:app": "vitest run src/tests/app"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "grammy": "^1.45.1",
    "helmet": "^8.2.0",
    "jose": "^6.2.9",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.0",
    "motion": "^12.23.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
